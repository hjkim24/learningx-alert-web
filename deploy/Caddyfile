{$APP_DOMAIN} {
	# Short on purpose; see SECURE_HSTS_SECONDS in config/settings.py.
	header Strict-Transport-Security "max-age=3600"

	# The feedback admin answers only to the tailnet (Tailscale CGNAT range).
	# Everyone else gets a plain 404, as if the path did not exist.
	@admin_outside_tailnet {
		path /{$ADMIN_PATH:ops-7f3c}/*
		not remote_ip {$ADMIN_ALLOWED_CIDRS:100.64.0.0/10}
	}
	respond @admin_outside_tailnet 404

	handle_path /static/* {
		root * /srv/static
		# collectstatic names hashed copies like app.3f2a9c1b7d4e.css; their
		# content never changes under that name, so browsers may keep them.
		@hashed path_regexp \.[0-9a-f]{12}\.[A-Za-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	reverse_proxy web:8000
}

# Tailnet-only entrance for the feedback admin. Bound to the host's loopback
# (compose publishes 127.0.0.1:8081), so the only way in is
# `tailscale serve --https=8443 http://127.0.0.1:8081`, which terminates TLS
# for {$ADMIN_TAILNET_HOST}. Only the admin, its Google sign-in and static files
# are served here; anything else goes to the public site.
http://:8081 {
	@tailnet_app path /{$ADMIN_PATH:ops-7f3c}/* /accounts/* /static/*
	handle @tailnet_app {
		handle_path /static/* {
			root * /srv/static
			file_server
		}
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		redir https://{$APP_DOMAIN}{uri} 302
	}
}
