DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_SECRET_KEY_FILE=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=
PILOT_ALLOWED_EMAILS=
CANVAS_BASE_URL=https://canvas.skku.edu
LEARNINGX_ALLOWED_HOSTS=canvas.skku.edu
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_KEYS_FILE=
DATABASE_PATH=db.sqlite3

# Open sign-up (1 = any Google-verified email; unset/0 = PILOT_ALLOWED_EMAILS only)
SIGNUP_OPEN=0
PRIVACY_CONTACT_EMAIL=

# Database: sqlite (default, uses DATABASE_PATH) or mysql
DATABASE_ENGINE=sqlite
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=learningx_alert
DATABASE_USER=learningx
DATABASE_PASSWORD=

# Web push (PWA); VAPID key is derived from DJANGO_SECRET_KEY unless set
WEB_PUSH_ENABLED=1
WEB_PUSH_SUBJECT=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Telemetry (off unless an OTLP endpoint is set)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.2
LOG_LEVEL=INFO
